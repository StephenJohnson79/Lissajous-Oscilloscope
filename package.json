{
  "name": "lissajous-oscilloscope",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node scripts/build.mjs",
    "start": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "lint": "node node_modules/oxlint/bin/oxlint app components lib public tests scripts *.ts",
    "format": "node node_modules/oxfmt/bin/oxfmt --write .",
    "test": "node --test tests/signal.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "description": "An interactive audio oscilloscope with Lissajous curves and time-domain waveforms."
}
